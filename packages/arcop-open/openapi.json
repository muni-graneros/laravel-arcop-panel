      "post": {
        "summary": "Records an informed consent with immutable evidence",
        "description": "Records an informed consent. The legal text and its SHA-256 are taken from the published version in consent_texts; the client cannot send them. Identity, IP and user agent are sealed in Node before insert. Requires an explicit capture_method: only arcop_capture yields strong evidence; operator_entered rejects an IP because it would be the operator address, not the subject one. The grant and the opening of the evidence chain happen in one transaction.",
        "parameters": [
          {
            "in": "header",
            "name": "X-Tenant-ID",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "in": "header",
            "name": "Idempotency-Key",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            },
            "description": "Reuse only for identical payload. Conflicting reuse returns 409."
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "definition_code": {
                    "type": "string",
                    "minLength": 2,
                    "maxLength": 80
                  },
                  "subject_identity": {
                    "type": "string",
                    "minLength": 3,
                    "maxLength": 255,
                    "description": "Encrypted before storage; never returned by the API."
                  },
                  "ip": {
                    "type": "string",
                    "maxLength": 64,
                    "description": "Encrypted. Required for arcop_capture, forbidden for operator_entered."
                  },
                  "user_agent": {
                    "type": "string",
                    "maxLength": 512,
                    "description": "Encrypted. Required for arcop_capture, forbidden for operator_entered."
                  },
                  "granted_at": {
                    "type": "string",
                    "format": "date-time"
                  },
                  "capture_method": {
                    "type": "string",
                    "enum": [
                      "arcop_capture",
                      "host_forwarded",
                      "host_asserted",
                      "operator_entered"
                    ]
                  }
                },
                "required": [
                  "definition_code",
                  "subject_identity",
                  "capture_method"
                ],
                "additionalProperties": false
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Success. See endpoint description for result fields.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
