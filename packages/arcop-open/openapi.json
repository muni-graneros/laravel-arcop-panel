    "/consents/{id}/texts": {
      "post": {
        "summary": "Publishes a new version of the legal text (admin)",
        "description": "Publishes a new version of the legal text and retires the previous one. The SHA-256 is computed by the database over the stored bytes, never taken from the client, and the published text and its hash are immutable afterwards. The path id accepts the consent id or the consent definition id, so the first version can be published before any consent exists.",
        "parameters": [
          {
            "in": "header",
            "name": "X-Tenant-ID",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
