    "/consents/{id}/restrict": {
      "post": {
        "summary": "Restricts the scope of an active consent",
        "description": "Restricts an active consent to a narrower scope, as an additional append-only event. A restricted consent can still be withdrawn.",
        "parameters": [
          {
            "in": "header",
            "name": "X-Tenant-ID",
            "required": true,
