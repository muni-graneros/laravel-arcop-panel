  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    },
    "schemas": {
      "Error": {
        "type": "object",
        "properties": {
          "error": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          },
          "request_id": {
            "type": "string",
            "format": "uuid"
          }
        },
        "required": [
          "error"
        ],
        "additionalProperties": false
      },
      "Consent": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "subject_ref": {
            "type": "string",
            "description": "HMAC reference of the subject. Not reversible."
          },
          "definition_code": {
            "type": "string"
          },
          "legal_version": {
            "type": "integer"
          },
          "legal_sha256": {
            "type": "string",
            "description": "SHA-256 of the published legal text at the moment of the grant."
          },
          "granted_at": {
            "type": "string",
            "format": "date-time"
          },
          "capture_method": {
            "type": "string",
            "enum": [
              "arcop_capture",
              "host_forwarded",
              "host_asserted",
              "operator_entered"
            ]
          },
          "evidence_strength": {
            "type": "string",
            "enum": [
              "strong",
              "declared"
            ],
            "description": "Derived: strong only when ARCOP itself captured the subject IP and user agent."
          },
          "status": {
            "type": "string",
            "enum": [
              "active",
              "withdrawn",
              "restricted"
            ]
          },
          "registered_by": {
            "type": "string"
          }
        }
      }
    }
  }
}
