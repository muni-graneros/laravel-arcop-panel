    "/consents/{id}/withdraw": {
      "post": {
        "summary": "Withdraws a consent as an additional event",
        "description": "Withdraws a consent. The original grant is never rewritten: the withdrawal is an append-only action plus a new link in the evidence chain. A withdrawn consent cannot be withdrawn again.",
        "parameters": [
          {
            "in": "header",
            "name": "X-Tenant-ID",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "reason": {
                    "type": "string",
                    "minLength": 10,
                    "maxLength": 2000
                  },
                  "scope": {
                    "type": "string",
                    "maxLength": 500
                  },
                  "evidence_sha256": {
                    "type": "string",
                    "pattern": "^[a-f0-9]{64}$"
                  },
                  "host_ref": {
                    "type": "string",
                    "maxLength": 255,
                    "description": "Hashed before storage; the host keeps the document."
                  }
                },
                "required": [],
                "additionalProperties": false
              }
            }
          }
        },
        "responses": {
          "200": {
