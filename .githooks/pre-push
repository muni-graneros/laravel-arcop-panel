#!/usr/bin/env bash
# STRIX_GUARD_HOOK_V1
set -uo pipefail
updates=""
if [[ ! -t 0 ]] && IFS= read -r -t 0.2 _primera_linea; then
  updates=$(printf '%s\n' "$_primera_linea"; cat)
fi
original="${BASH_SOURCE[0]}.xeon-strix-original"
rc=0
if [[ -x "$original" ]]; then
  if [[ -n "$updates" ]]; then
    printf '%s\n' "$updates" | "$original" "$@"
    rc=$?
  else
    printf '%s' "$updates" | "$original" "$@"
    rc=$?
  fi
fi
# Si el hook previo bloquea (rc != 0), el push se cancela igual: no se pierde.
[[ $rc -eq 0 ]] || exit $rc
GUARD="${STRIX_GUARD_BIN:-$HOME/Dev/scripts/strix-guard/strix-guard}"
if [[ -x "$GUARD" && "${STRIX_GUARD_HOOK_ACTIVADO:-1}" == "1" ]]; then
  rango=""
  while read -r local_ref local_sha remote_ref remote_sha; do
    [[ -z "${local_sha:-}" ]] && continue
    if [[ "$local_sha" == "0000000000000000000000000000000000000000" ]]; then continue; fi
    if [[ -n "${remote_sha:-}" && "$remote_sha" != "0000000000000000000000000000000000000000" ]]; then
      rango="$remote_sha..$local_sha"
    else
      rango="$local_sha"
    fi
    break
  done <<< "$updates"
  if [[ -z "$rango" ]]; then rango="HEAD"; fi
  "$GUARD" secreto "$rango" "$(git rev-parse --show-toplevel)" || exit $?
fi
exit 0
