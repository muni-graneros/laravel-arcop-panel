#!/usr/bin/env bash
# ──────────────────────────────────────────────────────────────────────────────
# commit-msg — rechaza atribución a la IA en el mensaje de commit.
#
# Por qué existe: la norma de trabajo (CLAUDE.md) prohíbe `Co-Authored-By: Claude`
# y cualquier referencia a `noreply@anthropic.com` en los commits: César es el
# único autor. El harness lo sugiere por defecto, así que la barrera tiene que
# estar acá, no depender de que se recuerde quitarlo a mano.
#
# Para saltárselo puntualmente:  git commit --no-verify
# ──────────────────────────────────────────────────────────────────────────────
set -euo pipefail

archivo_mensaje="$1"

if grep -qiE 'co-authored-by:.*claude|noreply@anthropic\.com' "$archivo_mensaje"; then
    echo "" >&2
    echo "❌ commit-msg: el mensaje atribuye el commit a la IA. Se canceló." >&2
    echo "   Quita la línea 'Co-Authored-By: Claude' y cualquier referencia a" >&2
    echo "   noreply@anthropic.com antes de commitear." >&2
    exit 1
fi

exit 0
